# Copy this file to ".env" and change the secrets. Never commit .env.

# ---------- Shared ----------
# Secret the Gateway uses to call the AI service (any long random string)
AI_API_KEY=change-me-ai-secret-123

# ---------- Gateway ----------
AI_URL=http://127.0.0.1:8001
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=smart_gate

# Minimum OCR confidence (0..1) to trust a plate read. Calibrate on real ESP32 images.
CONF_MIN=0.50
MIN_PLATE_LEN=6
# true = plate text must match Indian registration format before lookup
STRICT_FORMAT=true

AI_TIMEOUT_S=10
MAX_IMAGE_BYTES=2000000
ALLOWED_IMAGE_FORMATS=image/jpeg
# Same device + same plate within this many seconds is marked duplicate
COOLDOWN_S=10
# Max AI calls the gateway runs at once (others wait / get 429)
MAX_CONCURRENT_AI=2
TIMEZONE=Asia/Kolkata

# ---------- AI service ----------
YOLO_WEIGHTS=ai_service/models/best.pt
DET_CONF_MIN=0.25
# Set to true if you have an NVIDIA GPU with CUDA PyTorch installed
USE_GPU=false

# ---------- Seed script (device credential created by tools/seed_db.py) ----------
SEED_DEVICE_ID=gate-01
SEED_DEVICE_KEY=change-me-device-secret-456
SEED_GATE_NAME=Main Gate



mongoDB=anupam262009_db_user
